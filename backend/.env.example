# Copy to backend/.env and fill in your own key. Never commit backend/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# true=允许未填写访客 Key 的请求使用站长 Key；公开部署建议 false
AI_SERVER_KEY_ENABLED=true

# ===== 本地账号 =====
# 默认开启登录；仅测试/受控本地回归可临时设为 1。
WS_AUTH_DISABLED=0
# 公开部署首次初始化时建议设置；不设置则第一个访问者可认领本地账号。
WS_SETUP_TOKEN=

# ===== 商业与服务中心 =====
# 充值沙盒只在 localhost 默认开启，远程部署默认关闭。
# 显式设为 1 开启、0 关闭；关闭后充值订单保持待支付。
WS_BILLING_SANDBOX=
