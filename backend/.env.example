# Copy to backend/.env and fill in your own key. Never commit backend/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# true=允许未填写访客 Key 的请求使用站长 Key；公开部署建议 false
AI_SERVER_KEY_ENABLED=true

# ===== 本地账号 =====
# 默认开启登录；仅测试/受控本地回归可临时设为 1。
WS_AUTH_DISABLED=0
# 公开部署首次初始化时建议设置；不设置则第一个访问者可认领本地账号。
WS_SETUP_TOKEN=

# ===== 商业与服务中心 =====
# 充值沙盒只在 localhost 默认开启，远程部署默认关闭。
# 显式设为 1 开启、0 关闭；关闭后充值订单保持待支付。
WS_BILLING_SANDBOX=

# ===== 数据库 =====
# 本地默认 sqlite:///./world_simulator.db；线上推荐 PostgreSQL。
# Render/Railway 的 postgres:// 会自动规范化为 postgresql+psycopg://。
DATABASE_URL=sqlite:///./world_simulator.db

# ===== 多用户注册 =====
# 0=关闭公开注册；1=开放（仍需邀请码，除非 WS_INVITE_REQUIRED=0）。
WS_REGISTRATION_ENABLED=1
WS_INVITE_REQUIRED=1
# off=不验证邮箱；dev=控制台输出验证码；smtp=真实发信。
WS_EMAIL_MODE=off
WS_SMTP_HOST=
WS_SMTP_PORT=587
WS_SMTP_USER=
WS_SMTP_PASSWORD=
WS_SMTP_FROM=
WS_SMTP_SSL=0
WS_SMTP_TLS=1

# ===== 媒体存储 =====
# local=服务器磁盘；s3=任意 S3 兼容对象存储（Cloudflare R2、MinIO、AWS S3）。
WS_STORAGE_BACKEND=local
WS_UPLOAD_DIR=./uploads
WS_S3_BUCKET=
WS_S3_ENDPOINT=
WS_S3_REGION=auto
WS_S3_ACCESS_KEY=
WS_S3_SECRET_KEY=
WS_S3_PUBLIC_BASE=

# ===== 跨域 =====
WS_CORS_ORIGINS=
WS_CORS_ORIGIN_REGEX=https://world-simulator-.*\.vercel\.app
